\par }\pard\plain \s20\qc\nowidctlpar\widctlpar\adjustright \b\f15\fs27\cgrid {\b0\fs26 01. M\'f4c \'ae\'ddch c\'f1a chu\'c8n m\'f9c n\'b5y l\'b5 quy \'ae\'denh v\'b5 h\'ad\'edng d\'c9n c\'b8c nguy\'aan t\'bec v\'b5 ph\'ad\'acng ph\'b8p k\'d5 to\'b8n \'ae\'e8
i v\'edi b\'aan thu\'aa v\'b5 b\'aan cho thu\'aa t\'b5i s\'b6n, bao g\'e5m thu\'aa t\'b5i ch\'ddnh v\'b5 thu\'aa ho\'b9t \'ae\'e9ng, l\'b5m c\'ac s\'eb ghi s\'e6 k\'d5 to\'b8n v\'b5 l\'cbp b\'b8o c\'b8o t\'b5i ch\'ddnh.
\par }\pard\plain \qj\nowidctlpar\widctlpar\adjustright \fs20\cgrid {\f15 
\par }{\b\f15\fs25 02. Chu\'c8n m\'f9c n\'b5y \'b8p d\'f4ng cho k\'d5 to\'b8n thu\'aa t\'b5i s\'b6n, ngo\'b9i tr\'f5:
\par }{\f15\fs16 
\par }\pard\plain \s19\qj\fi-283\li709\nowidctlpar\widctlpar\adjustright \f15\fs28\cgrid {a) H\'eep \'ae\'e5ng thu\'aa \'ae\'d3 khai th\'b8c, s\'f6 d\'f4ng t\'b5i nguy\'aan thi\'aan nhi\'aan nh\'ad d\'c7u, kh\'dd, g\'e7, kim lo\'b9i v\'b5 c\'b8c kho\'b8ng s
\'b6n kh\'b8c;
\par }\pard\plain \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright \fs20\cgrid {\f15\fs16 
\par }{\b\f15\fs25 b) H\'eep \'ae\'e5ng s\'f6 d\'f4ng b\'b6n quy\'d2n nh\'ad phim, b\'a8ng vid\'d0o, nh\'b9c k\'dech, b\'b6n quy\'d2n t\'b8c gi\'b6, b\'bbng s\'b8ng ch\'d5.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 03. Chu\'c8n m\'f9c n\'b5y \'b8p d\'f4ng cho c\'b6 tr\'ad\'eang h\'eep chuy\'d3n quy\'d2n s\'f6 d\'f4ng t\'b5i s\'b6n ngay c\'b6 khi b\'aan cho thu\'aa \'ae\'ad\'eec y\'aau c\'c7u th\'f9
c hi\'d6n c\'b8c d\'dech v\'f4 ch\'f1 y\'d5u li\'aan quan \'ae\'d5n \'aei\'d2u h\'b5nh, s\'f6a ch\'f7a, b\'b6o d\'ad\'ecng t\'b5i s\'b6n cho thu\'aa. Chu\'c8n m\'f9c n\'b5y kh\'abng \'b8p d\'f4ng cho c\'b8c h\'eep \'ae\'e5ng d\'dech v\'f4 kh\'abng chuy
\'d3n quy\'d2n s\'f6 d\'f4ng t\'b5i s\'b6n.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15 
\par }{\b\f15\fs25 04. C\'b8c thu\'cbt ng\'f7 trong chu\'c8n m\'f9c n\'b5y \'ae\'ad\'eec hi\'d3u nh\'ad sau:
\par }{\f15 
\par }\pard \qj\li426\nowidctlpar\widctlpar\adjustright {\b\i\f15\fs25 Thu\'aa t\'b5i s\'b6n:}{\b\f15\fs25  L\'b5 s\'f9 tho\'b6 thu\'cbn gi\'f7a b\'aan cho thu\'aa v\'b5 b\'aan thu\'aa v\'d2 vi\'d6c b\'aan cho thu\'aa chuy\'d3n quy\'d2n s\'f6 d\'f4ng t\'b5i s
\'b6n cho b\'aan thu\'aa trong m\'e9t kho\'b6ng th\'eai gian nh\'cat \'ae\'denh \'ae\'d3 \'ae\'ad\'eec nh\'cbn ti\'d2n cho thu\'aa m\'e9t l\'c7n ho\'c6c nhi\'d2u l\'c7n.
\par }{\f15 
\par }{\b\i\f15\fs25 Thu\'aa t\'b5i ch\'ddnh:}{\b\f15\fs25  L\'b5 thu\'aa t\'b5i s\'b6n m\'b5 b\'aan cho thu\'aa c\'e3 s\'f9 chuy\'d3n giao ph\'c7n l\'edn r\'f1i ro v\'b5 l\'eei \'ddch g\'ben li\'d2n v\'edi quy\'d2n s\'eb h\'f7u t\'b5i s\'b6n cho b\'aan thu
\'aa. Quy\'d2n s\'eb h\'f7u t\'b5i s\'b6n c\'e3 th\'d3 chuy\'d3n giao v\'b5o cu\'e8i th\'eai h\'b9n thu\'aa.
\par }{\f15 
\par }{\b\i\f15\fs25 Thu\'aa ho\'b9t \'ae\'e9ng:}{\b\f15\fs25  L\'b5 thu\'aa t\'b5i s\'b6n kh\'abng ph\'b6i l\'b5 thu\'aa t\'b5i ch\'ddnh.
\par }{\f15 
\par }{\b\i\f15\fs25 H\'eep \'ae\'e5ng thu\'aa t\'b5i s\'b6n kh\'abng hu\'fb ngang:}{\b\f15\fs25  L\'b5 h\'eep \'ae\'e5ng thu\'aa t\'b5i s\'b6n m\'b5 hai b\'aan kh\'abng th\'d3 \'ae\'acn ph\'ad\'acng ch\'cam d\'f8t h\'eep \'ae\'e5ng, tr\'f5 c\'b8c tr\'ad\'ea
ng h\'eep:
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs14 
\par }\pard \qj\fi426\nowidctlpar\widctlpar\adjustright {\b\f15\fs25 a) C\'e3 s\'f9 ki\'d6n b\'cat th\'ad\'eang x\'c8y ra, nh\'ad:
\par }{\f15\fs12 
\par }\pard \qj\fi709\nowidctlpar\widctlpar\adjustright {\b\f15\fs25 - B\'aan cho thu\'aa kh\'abng giao \'ae\'f3ng h\'b9n t\'b5i s\'b6n cho thu\'aa;
\par }{\f15\fs12 
\par }{\b\f15\fs25 - B\'aan thu\'aa kh\'abng tr\'b6 ti\'d2n thu\'aa theo quy \'ae\'denh trong h\'eep \'ae\'e5ng thu\'aa t\'b5i s\'b6n;
\par }\pard \qj\fi-142\li851\nowidctlpar\widctlpar\adjustright {\f15\fs12 
\par }{\b\f15\fs25 - B\'aan thu\'aa ho\'c6c b\'aan cho thu\'aa vi ph\'b9m h\'eep \'ae\'e5ng;
\par - B\'aan thu\'aa b\'de ph\'b8 s\'b6n, ho\'c6c gi\'b6i th\'d3;
\par }{\f15\fs12 
\par }{\b\f15\fs25 - Ng\'ad\'eai b\'b6o l\'b7nh b\'de ph\'b8 s\'b6n, ho\'c6c gi\'b6i th\'d3 v\'b5 b\'aan cho thu\'aa kh\'abng ch\'cap thu\'cbn \'ae\'d2 ngh\'de ch\'cam d\'f8t b\'b6o l\'b7nh ho\'c6c \'ae\'d2 ngh\'de ng\'ad\'eai b\'b6o l\'b7nh kh\'b8c thay th
\'d5 c\'f1a b\'aan thu\'aa;
\par }{\f15\fs12 
\par }{\b\f15\fs25 - T\'b5i s\'b6n cho thu\'aa b\'de m\'cat, ho\'c6c h\'ad h\'e1ng kh\'abng th\'d3 s\'f6a ch\'f7a ph\'f4c h\'e5i \'ae\'ad\'eec.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs18 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\b\f15\fs25 b) \'a7\'ad\'eec s\'f9 \'ae\'e5ng \'fd c\'f1a b\'aan cho thu\'aa;
\par }{\f15\fs18 
\par }{\b\f15\fs25 c) N\'d5u 2 b\'aan tho\'b6 thu\'cbn m\'e9t h\'eep \'ae\'e5ng m\'edi v\'d2 thu\'aa ch\'ddnh t\'b5i s\'b6n \'ae\'e3 ho\'c6c t\'b5i s\'b6n t\'ad\'acng t\'f9;
\par }{\f15\fs18 
\par }{\b\f15\fs25 d) B\'aan thu\'aa thanh to\'b8n th\'aam m\'e9t kho\'b6n ti\'d2n ngay t\'b9i th\'eai \'aei\'d3m kh\'ebi \'ae\'c7u thu\'aa t\'b5i s\'b6n.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\li426\nowidctlpar\widctlpar\adjustright {\b\i\f15\fs25 Th\'eai \'aei\'d3m kh\'ebi \'ae\'c7u thu\'aa t\'b5i s\'b6n}{\b\f15\fs25 : L\'b5 ng\'b5y x\'c8y ra tr\'ad\'edc c\'f1a m\'e9t trong hai (2) ng\'b5y: Ng\'b5y quy\'d2n s\'f6 d\'f4ng t\'b5i s
\'b6n \'ae\'ad\'eec chuy\'d3n giao cho b\'aan thu\'aa v\'b5 ng\'b5y ti\'d2n thu\'aa b\'bet \'ae\'c7u \'ae\'ad\'eec t\'ddnh theo c\'b8c \'aei\'d2u kho\'b6n quy \'ae\'denh trong h\'eep \'ae\'e5ng.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Th\'eai h\'b9n thu\'aa t\'b5i s\'b6n}{\b\f15\fs25 : L\'b5 kho\'b6ng th\'eai gian c\'f1a h\'eep \'ae\'e5ng thu\'aa t\'b5i s\'b6n kh\'abng hu\'fb ngang c\'e9ng (+) v\'edi kho\'b6ng th\'eai gian b\'aan thu\'aa \'ae\'ad\'eec gia h\'b9n thu\'aa
 t\'b5i s\'b6n \'ae\'b7 ghi trong h\'eep \'ae\'e5ng, ph\'b6i tr\'b6 th\'aam ho\'c6c kh\'abng ph\'b6i tr\'b6 th\'aam chi ph\'dd n\'d5u quy\'d2n gia h\'b9n n\'b5y x\'b8c \'ae\'denh \'ae\'ad\'eec t\'ad\'acng \'ae\'e8i ch\'bec ch\'ben ngay t\'b9i th\'eai \'ae
i\'d3m kh\'ebi \'ae\'c7u thu\'aa t\'b5i s\'b6n.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Kho\'b6n thanh to\'b8n ti\'d2n thu\'aa t\'e8i thi\'d3u:
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs18 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\b\i\f15\fs25 a) \'a7\'e8i v\'edi b\'aan thu\'aa:}{\b\f15\fs25  L\'b5 kho\'b6n thanh to\'b8n m\'b5 b\'aan thu\'aa ph\'b6i tr\'b6 cho b\'aan cho thu\'aa v\'d2 vi\'d6c thu\'aa t\'b5i s\'b6n theo th
\'eai h\'b9n trong h\'eep \'ae\'e5ng (Kh\'abng bao g\'e5m c\'b8c kho\'b6n chi ph\'dd d\'dech v\'f4 v\'b5 thu\'d5 do b\'aan cho thu\'aa \'ae\'b7 tr\'b6 m\'b5 b\'aan thu\'aa ph\'b6i ho\'b5n l\'b9i v\'b5 ti\'d2n thu\'aa ph\'b8t sinh th\'aam), k\'ccm theo b
\'cat c\'f8 gi\'b8 tr\'de n\'b5o \'ae\'ad\'eec b\'aan thu\'aa ho\'c6c m\'e9t b\'aan li\'aan quan \'ae\'d5n b\'aan thu\'aa \'ae\'b6m b\'b6o thanh to\'b8n. 
\par }{\f15\fs18 
\par }{\b\i\f15\fs25 b) \'a7\'e8i v\'edi b\'aan cho thu\'aa:}{\b\f15\fs25  L\'b5 kho\'b6n thanh to\'b8n m\'b5 b\'aan thu\'aa ph\'b6i tr\'b6 cho b\'aan cho thu\'aa theo th\'eai h\'b9n thu\'aa trong h\'eep \'ae\'e5ng (Kh\'abng bao g\'e5m c\'b8c kho\'b6n chi ph
\'dd d\'dech v\'f4 v\'b5 thu\'d5 do b\'aan cho thu\'aa \'ae\'b7 tr\'b6 m\'b5 b\'aan thu\'aa ph\'b6i ho\'b5n l\'b9i v\'b5 ti\'d2n thu\'aa ph\'b8t sinh th\'aam) c\'e9ng (+) v\'edi gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n cho thu\'aa \'ae\'ad\'eec 
\'ae\'b6m b\'b6o thanh to\'b8n b\'ebi:
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs12 
\par }\pard \qj\fi709\nowidctlpar\widctlpar\adjustright {\b\f15\fs25 - B\'aan thu\'aa;
\par }{\f15\fs12 
\par }{\b\f15\fs25 - M\'e9t b\'aan li\'aan quan \'ae\'d5n b\'aan thu\'aa; ho\'c6c
\par }{\f15\fs12 
\par }{\b\f15\fs25 - M\'e9t b\'aan th\'f8 ba \'ae\'e9c l\'cbp c\'e3 kh\'b6 n\'a8ng t\'b5i ch\'ddnh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs18 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\b\f15\fs25 c) Tr\'ad\'eang h\'eep trong h\'eep \'ae\'e5ng thu\'aa bao g\'e5m \'aei\'d2u kho\'b6n b\'aan thu\'aa \'ae\'ad\'eec quy\'d2n mua l\'b9i t\'b5i s\'b6n thu\'aa v\'edi gi\'b8 th\'cap h\'ac
n gi\'b8 tr\'de h\'eep l\'fd v\'b5o ng\'b5y mua th\'d7 kho\'b6n thanh to\'b8n ti\'d2n thu\'aa t\'e8i thi\'d3u (\'a7\'e8i v\'edi c\'b6 b\'aan cho thu\'aa v\'b5 b\'aan \'aei thu\'aa) bao g\'e5m ti\'d2n thu\'aa t\'e8i thi\'d3u ghi trong h\'eep \'ae\'e5
ng theo th\'eai h\'b9n thu\'aa v\'b5 kho\'b6n thanh to\'b8n c\'c7n thi\'d5t cho vi\'d6c mua t\'b5i s\'b6n \'ae\'e3.
\par }\pard \qj\li426\nowidctlpar\widctlpar\adjustright {\b\i\f15\fs25 Gi\'b8 tr\'de h\'eep l\'fd:}{\b\f15\fs25  L\'b5 gi\'b8 tr\'de t\'b5i s\'b6n c\'e3 th\'d3 \'ae\'ad\'eec trao \'ae\'e6i ho\'c6c gi\'b8 tr\'de m\'e9t kho\'b6n n\'ee \'ae\'ad\'eec thanh to\'b8
n m\'e9t c\'b8ch t\'f9 nguy\'d6n gi\'f7a c\'b8c b\'aan c\'e3 \'ae\'c7y \'ae\'f1 hi\'d3u bi\'d5t trong s\'f9 trao \'ae\'e6i ngang gi\'b8.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n cho thu\'aa:}{\b\f15\fs25  L\'b5 gi\'b8 tr\'de \'ad\'edc t\'ddnh \'eb th\'eai \'aei\'d3m kh\'ebi \'ae\'c7u thu\'aa t\'b5i s\'b6n m\'b5 b\'aan cho thu\'aa d\'f9 t\'ddnh s\'cf thu \'ae\'ad\'ee
c t\'f5 t\'b5i s\'b6n cho thu\'aa v\'b5o l\'f3c k\'d5t th\'f3c h\'eep \'ae\'e5ng cho thu\'aa.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n thu\'aa \'ae\'ad\'eec \'ae\'b6m b\'b6o:}{\b\f15\fs25 
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs18 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\b\i\f15\fs25 a) \'a7\'e8i v\'edi b\'aan thu\'aa:}{\b\f15\fs25  L\'b5 ph\'c7n gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n thu\'aa \'ae\'ad\'eec b\'aan thu\'aa ho\'c6c b\'aan li\'aan quan v
\'edi b\'aan thu\'aa \'ae\'b6m b\'b6o thanh to\'b8n cho b\'aan cho thu\'aa (Gi\'b8 tr\'de \'ae\'b6m b\'b6o l\'b5 s\'e8 ti\'d2n b\'aan thu\'aa ph\'b6i tr\'b6 cao nh\'cat trong b\'cat c\'f8 tr\'ad\'eang h\'eep n\'b5o).
\par }{\f15\fs18 
\par }{\b\i\f15\fs25 b) \'a7\'e8i v\'edi b\'aan cho thu\'aa:}{\b\f15\fs25  L\'b5 ph\'c7n gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n thu\'aa \'ae\'ad\'eec b\'aan thu\'aa ho\'c6c b\'aan th\'f8 ba c\'e3 kh\'b6 n\'a8ng t\'b5i ch\'ddnh kh\'abng li\'aan quan v
\'edi b\'aan cho thu\'aa, \'ae\'b6m b\'b6o thanh to\'b8n.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\li426\nowidctlpar\widctlpar\adjustright {\b\i\f15\fs25 Gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n thu\'aa kh\'abng \'ae\'ad\'eec \'ae\'b6m b\'b6o:}{\b\f15\fs25  L\'b5 ph\'c7n gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n thu\'aa \'ae
\'ad\'eec x\'b8c \'ae\'denh b\'ebi b\'aan cho thu\'aa kh\'abng \'ae\'ad\'eec b\'aan thu\'aa ho\'c6c b\'aan li\'aan quan \'ae\'d5n b\'aan thu\'aa \'ae\'b6m b\'b6o thanh to\'b8n ho\'c6c ch\'d8 \'ae\'ad\'eec m\'e9t b\'aan li\'aan quan v\'edi b\'aan cho thu
\'aa, \'ae\'b6m b\'b6o thanh to\'b8n.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Th\'eai gian s\'f6 d\'f4ng kinh t\'d5:}{\b\f15\fs25  L\'b5 kho\'b6ng th\'eai gian m\'b5 t\'b5i s\'b6n \'ae\'ad\'eec \'ad\'edc t\'ddnh s\'f6 d\'f4ng m\'e9t c\'b8ch h\'f7u \'ddch ho\'c6c s\'e8 l\'ad\'eeng s\'b6n ph\'c8m hay \'ae\'acn v\'de t
\'ad\'acng \'ae\'ad\'acng c\'e3 th\'d3 thu \'ae\'ad\'eec t\'f5 t\'b5i s\'b6n cho thu\'aa do m\'e9t ho\'c6c nhi\'d2u ng\'ad\'eai s\'f6 d\'f4ng t\'b5i s\'b6n.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Th\'eai gian s\'f6 d\'f4ng h\'f7u \'ddch:}{\b\f15\fs25  L\'b5 kho\'b6ng th\'eai gian s\'f6 d\'f4ng kinh t\'d5 c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n thu\'aa k\'d3 t\'f5 th\'eai \'aei\'d3m b\'bet \'ae\'c7u thu\'aa, kh\'abng gi\'edi h\'b9n theo
 th\'eai h\'b9n h\'eep \'ae\'e5ng thu\'aa.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 \'a7\'c7u t\'ad g\'e9p trong h\'eep \'ae\'e5ng thu\'aa t\'b5i ch\'ddnh:}{\b\f15\fs25  L\'b5 t\'e6ng kho\'b6n thanh to\'b8n ti\'d2n thu\'aa t\'e8i thi\'d3u theo h\'eep \'ae\'e5ng thu\'aa t\'b5i ch\'ddnh (\'ae\'e8i v\'edi b\'aan cho thu\'aa
) c\'e9ng (+) gi\'b8 tr\'de c\'dfn l\'b9i c\'f1a t\'b5i s\'b6n thu\'aa kh\'abng \'ae\'ad\'eec \'ae\'b6m b\'b6o.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Doanh thu t\'b5i ch\'ddnh ch\'ada th\'f9c hi\'d6n:}{\b\f15\fs25  L\'b5 s\'e8 ch\'aanh l\'d6ch gi\'f7a t\'e6ng kho\'b6n thanh to\'b8n ti\'d2n thu\'aa t\'e8i thi\'d3u c\'e9ng (+) gi\'b8 tr\'de c\'dfn l\'b9i kh\'abng \'ae\'ad\'eec \'ae\'b6m b
\'b6o tr\'f5 (-) gi\'b8 tr\'de hi\'d6n t\'b9i c\'f1a c\'b8c kho\'b6n tr\'aan t\'ddnh theo t\'fb l\'d6 l\'b7i su\'cat ng\'c7m \'ae\'denh trong h\'eep \'ae\'e5ng thu\'aa t\'b5i ch\'ddnh.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 \'a7\'c7u t\'ad thu\'c7n trong h\'eep \'ae\'e5ng thu\'aa t\'b5i ch\'ddnh:}{\b\f15\fs25  L\'b5 s\'e8 ch\'aanh l\'d6ch gi\'f7a \'ae\'c7u t\'ad g\'e9p trong h\'eep \'ae\'e5ng thu\'aa t\'b5i ch\'ddnh v\'b5 doanh thu t\'b5i ch\'ddnh ch\'ada th
\'f9c hi\'d6n.
\par 
\par }{\b\i\f15\fs25 L\'b7i su\'cat ng\'c7m \'ae\'denh trong h\'eep \'ae\'e5ng thu\'aa t\'b5i ch\'ddnh:}{\b\f15\fs25  L\'b5 t\'fb l\'d6 chi\'d5t kh\'cau t\'b9i th\'eai \'aei\'d3m kh\'ebi \'ae\'c7u thu\'aa t\'b5i s\'b6n, \'ae\'d3 t\'ddnh gi\'b8 tr\'de hi\'d6n t
\'b9i c\'f1a kho\'b6n thanh to\'b8n ti\'d2n thu\'aa t\'e8i thi\'d3u v\'b5 gi\'b8 tr\'de hi\'d6n t\'b9i c\'f1a gi\'b8 tr\'de c\'dfn l\'b9i kh\'abng \'ae\'ad\'eec \'ae\'b6m b\'b6o \'ae\'d3 cho t\'e6ng c\'f1a ch\'f3ng \'ae\'f3ng b\'bbng gi\'b8 tr\'de h\'ee
p l\'fd c\'f1a t\'b5i s\'b6n thu\'aa.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 L\'b7i su\'cat bi\'aan \'aei vay:}{\b\f15\fs25  L\'b5 l\'b7i su\'cat m\'b5 b\'aan thu\'aa s\'cf ph\'b6i tr\'b6 cho m\'e9t h\'eep \'ae\'e5ng thu\'aa t\'b5i ch\'ddnh t\'ad\'acng t\'f9 ho\'c6c l\'b5 l\'b7i su\'cat t\'b9i th\'eai \'aei\'d3m kh
\'ebi \'ae\'c7u thu\'aa t\'b5i s\'b6n m\'b5 b\'aan thu\'aa s\'cf ph\'b6i tr\'b6 \'ae\'d3 vay m\'e9t kho\'b6n c\'c7n thi\'d5t cho vi\'d6c mua t\'b5i s\'b6n v\'edi m\'e9t th\'eai h\'b9n v\'b5 v\'edi m\'e9t \'ae\'b6m b\'b6o t\'ad\'acng t\'f9.
\par }{\f15\fs22 
\par }{\b\i\f15\fs25 Ti\'d2n thu\'aa c\'e3 th\'d3 ph\'b8t sinh th\'aam:}{\b\f15\fs25  L\'b5 m\'e9t ph\'c7n c\'f1a kho\'b6n thanh to\'b8n ti\'d2n thu\'aa, nh\'adng kh\'abng c\'e8 \'ae\'denh v\'b5 \'ae\'ad\'eec x\'b8c \'ae\'denh d\'f9a tr\'aan m\'e9t y\'d5u t
\'e8 n\'b5o \'ae\'e3 ngo\'b5i y\'d5u t\'e8 th\'eai gian, v\'dd d\'f4: ph\'c7n tr\'a8m (%) tr\'aan doanh thu, s\'e8 l\'ad\'eeng s\'f6 d\'f4ng, ch\'d8 s\'e8 gi\'b8, l\'b7i su\'cat th\'de tr\'ad\'eang.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }\pard\plain \s20\qc\nowidctlpar\widctlpar\adjustright \b\f15\fs27\cgrid {\b0\fs26 05. H\'eep \'ae\'e5ng thu\'aa t\'b5i s\'b6n bao g\'e5m c\'b8c quy \'ae\'denh cho ph\'d0p b\'aan thu\'aa \'ae\'ad\'eec mua t\'b5i s\'b6n khi \'ae\'b7 th\'f9c hi\'d6n \'ae
\'c7y \'ae\'f1 c\'b8c \'aei\'d2u ki\'d6n tho\'b6 thu\'cbn trong h\'eep \'ae\'e5ng \'ae\'e3 g\'e4i l\'b5 h\'eep \'ae\'e5ng thu\'aa mua.
