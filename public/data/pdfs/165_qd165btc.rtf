\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 14. Chi ph\'dd cho vi\'d6c \'ae\'c7u t\'ad x\'a9y d\'f9ng ho\'c6c s\'b6n xu\'cat m\'e9t t\'b5i s\'b6n d\'eb dang bao g\'e5m c\'b8c chi ph\'dd ph\'b6i thanh to\'b8n b\'bbng ti\'d2n, chuy
\'d3n giao c\'b8c t\'b5i s\'b6n kh\'b8c ho\'c6c ch\'cap nh\'cbn c\'b8c kho\'b6n n\'ee ph\'b6i tr\'b6 l\'b7i, kh\'abng t\'ddnh \'ae\'d5n c\'b8c kho\'b6n tr\'ee c\'cap ho\'c6c h\'e7 tr\'ee li\'aan quan \'ae\'d5n t\'b5i s\'b6n.
\par 
\par }\pard\plain \s18\qj\fi-426\li426\nowidctlpar\widctlpar\adjustright \f15\fs28\cgrid {15. C\'b8c ho\'b9t \'ae\'e9ng c\'c7n thi\'d5t cho vi\'d6c chu\'c8n b\'de \'ae\'ada t\'b5i s\'b6n v\'b5o s\'f6 d\'f4ng ho\'c6c b\'b8n bao g\'e5m ho\'b9t \'ae\'e9ng x\'a9
y d\'f9ng, s\'b6n xu\'cat, ho\'b9t \'ae\'e9ng k\'fc thu\'cbt v\'b5 qu\'b6n l\'fd chung tr\'ad\'edc khi b\'bet \'ae\'c7u x\'a9y d\'f9ng, s\'b6n xu\'cat nh\'ad  ho\'b9t \'ae\'e9ng li\'aan quan \'ae\'d5n vi\'d6c xin gi\'cay ph\'d0p tr\'ad\'edc khi kh\'ebi c
\'abng x\'a9y d\'f9ng ho\'c6c s\'b6n xu\'cat. Tuy nhi\'aan nh\'f7ng ho\'b9t \'ae\'e9ng n\'b5y kh\'abng bao g\'e5m vi\'d6c gi\'f7 m\'e9t t\'b5i s\'b6n khi kh\'abng ti\'d5n h\'b5nh c\'b8c ho\'b9t \'ae\'e9ng x\'a9y d\'f9ng ho\'c6c s\'b6n xu\'cat \'ae\'d3
 thay \'ae\'e6i tr\'b9ng th\'b8i c\'f1a t\'b5i s\'b6n n\'b5y. V\'dd d\'f4 chi ph\'dd \'aei vay li\'aan quan \'ae\'d5n vi\'d6c mua m\'e9t m\'b6nh \'ae\'cat c\'c7n c\'e3 c\'b8c ho\'b9t \'ae\'e9ng chu\'c8n b\'de m\'c6t b\'bbng s\'cf \'ae\'ad\'eec v\'e8n ho
\'b8 trong k\'fa khi c\'b8c ho\'b9t \'ae\'e9ng li\'aan quan \'ae\'d5n vi\'d6c chu\'c8n b\'de m\'c6t b\'bbng \'ae\'e3. Tuy nhi\'aan, chi ph\'dd \'aei vay ph\'b8t sinh khi mua m\'b6nh \'ae\'cat \'ae\'e3 \'ae\'d3 gi\'f7 m\'b5 kh\'abng c\'e3 ho\'b9t \'ae\'e9
ng tri\'d3n khai x\'a9y d\'f9ng li\'aan quan \'ae\'d5n m\'b6nh \'ae\'cat \'ae\'e3 th\'d7 chi ph\'dd \'aei vay kh\'abng \'ae\'ad\'eec v\'e8n ho\'b8. 
