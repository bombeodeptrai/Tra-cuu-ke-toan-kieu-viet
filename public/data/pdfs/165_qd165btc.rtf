\par }{\b\i\f15\fs26  (Ban h\'b5nh v\'b5 c\'abng b\'e8 theo Quy\'d5t \'ae\'denh s\'e8 165/2002/Q\'a7-BTC
\par ng\'b5y 31 th\'b8ng 12 n\'a8m 2002 c\'f1a B\'e9 tr\'ad\'ebng B\'e9 T\'b5i ch\'ddnh)
\par }{\f15\fs24 
\par 
\par }\pard\plain \s8\qj\keepn\nowidctlpar\widctlpar\outlinelevel7\adjustright \b\f19\cgrid {Quy \'ae\'denh chung
\par }\pard\plain \qj\nowidctlpar\widctlpar\adjustright \fs20\cgrid {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 01. M\'f4c \'ae\'ddch c\'f1a chu\'c8n m\'f9c n\'b5y l\'b5 quy \'ae\'denh v\'b5 h\'ad\'edng d\'c9n c\'b8c nguy\'aan t\'bec v\'b5 y\'aau c\'c7u k\'d5 to\'b8n c\'ac b\'b6n, c\'b8c y\'d5u t
\'e8 v\'b5 ghi nh\'cbn c\'b8c y\'d5u t\'e8 c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh c\'f1a doanh nghi\'d6p, nh\'bbm:
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs16 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\f15\fs26 a/ L\'b5m c\'ac s\'eb x\'a9y d\'f9ng v\'b5 ho\'b5n thi\'d6n c\'b8c chu\'c8n m\'f9c k\'d5 to\'b8n v\'b5 ch\'d5 \'ae\'e9 k\'d5 to\'b8n c\'f4 th\'d3 theo khu\'abn m\'c9u th\'e8ng nh\'cat;

\par }{\f15\fs16 
\par }{\f15\fs26 b/ Gi\'f3p cho doanh nghi\'d6p ghi ch\'d0p k\'d5 to\'b8n v\'b5 l\'cbp b\'b8o c\'b8o t\'b5i ch\'ddnh theo c\'b8c chu\'c8n m\'f9c k\'d5 to\'b8n v\'b5 ch\'d5 \'ae\'e9 k\'d5 to\'b8n \'ae\'b7 ban h\'b5nh m\'e9t c\'b8ch th\'e8ng nh\'cat v\'b5 x\'f6
 l\'fd c\'b8c v\'can \'ae\'d2 ch\'ada \'ae\'ad\'eec quy \'ae\'denh c\'f4 th\'d3 nh\'bbm \'ae\'b6m b\'b6o cho c\'b8c th\'abng tin tr\'aan b\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6n \'b8nh trung th\'f9c v\'b5 h\'eep l\'fd;
\par }{\f15\fs16 
\par }{\f15\fs26 c/ Gi\'f3p cho ki\'d3m to\'b8n vi\'aan v\'b5 ng\'ad\'eai ki\'d3m tra k\'d5 to\'b8n \'ae\'ada ra \'fd ki\'d5n v\'d2 s\'f9 ph\'ef h\'eep c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh v\'edi chu\'c8n m\'f9c k\'d5 to\'b8n v\'b5 ch\'d5 \'ae\'e9 k\'d5 to\'b8
n;
\par }{\f15\fs16 
\par }{\f15\fs26 d/ Gi\'f3p cho ng\'ad\'eai s\'f6 d\'f4ng b\'b8o c\'b8o t\'b5i ch\'ddnh hi\'d3u v\'b5 \'ae\'b8nh gi\'b8 th\'abng tin t\'b5i ch\'ddnh \'ae\'ad\'eec l\'cbp ph\'ef h\'eep v\'edi c\'b8c chu\'c8n m\'f9c k\'d5 to\'b8n v\'b5 ch\'d5 \'ae\'e9 k\'d5 to
\'b8n.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 02. C\'b8c nguy\'aan t\'bec, y\'aau c\'c7u k\'d5 to\'b8n c\'ac b\'b6n v\'b5 c\'b8c y\'d5u t\'e8 c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh quy \'ae\'denh trong chu\'c8n m\'f9c n\'b5y \'ae\'ad
\'eec quy \'ae\'denh c\'f4 th\'d3 trong t\'f5ng chu\'c8n m\'f9c k\'d5 to\'b8n, ph\'b6i \'ae\'ad\'eec \'b8p d\'f4ng \'ae\'e8i v\'edi m\'e4i doanh nghi\'d6p thu\'e9c m\'e4i th\'b5nh ph\'c7n kinh t\'d5 trong ph\'b9m vi c\'b6 n\'ad\'edc.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 Chu\'c8n m\'f9c n\'b5y kh\'abng thay th\'d5 c\'b8c chu\'c8n m\'f9c k\'d5 to\'b8n c\'f4 th\'d3. Khi th\'f9c hi\'d6n th\'d7 c\'a8n c\'f8 v\'b5o chu\'c8n m\'f9c k\'d5 to\'b8n c\'f4 th\'d3. Tr\'ad
\'eang h\'eep chu\'c8n m\'f9c k\'d5 to\'b8n c\'f4 th\'d3 ch\'ada quy \'ae\'denh th\'d7 th\'f9c hi\'d6n theo Chu\'c8n m\'f9c chung.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }\pard\plain \s8\qj\keepn\nowidctlpar\widctlpar\outlinelevel7\adjustright \b\f19\cgrid {N\'e9i dung chu\'c8n m\'f9c
\par }\pard\plain \qj\nowidctlpar\widctlpar\adjustright \fs20\cgrid {\f15\fs22 
\par }\pard\plain \s9\qj\keepn\nowidctlpar\widctlpar\outlinelevel8\adjustright \b\f20\fs22\cgrid {C\'b8c nguy\'aan t\'bec k\'d5 to\'b8n c\'ac b\'b6n
\par }\pard\plain \qj\nowidctlpar\widctlpar\adjustright \fs20\cgrid {\f15\fs22 
\par }{\b\f15\fs26 C\'ac s\'eb d\'e5n t\'ddch
\par }{\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 03. M\'e4i nghi\'d6p v\'f4 kinh t\'d5, t\'b5i ch\'ddnh c\'f1a doanh nghi\'d6p li\'aan quan \'ae\'d5n t\'b5i s\'b6n, n\'ee ph\'b6i tr\'b6, ngu\'e5n v\'e8n ch\'f1 s\'eb h\'f7
u, doanh thu, chi ph\'dd ph\'b6i \'ae\'ad\'eec ghi s\'e6 k\'d5 to\'b8n v\'b5o th\'eai \'aei\'d3m ph\'b8t sinh, kh\'abng c\'a8n c\'f8 v\'b5o th\'eai \'aei\'d3m th\'f9c t\'d5 thu ho\'c6c th\'f9c t\'d5 chi ti\'d2n ho\'c6c t\'ad\'acng \'ae\'ad\'acng ti\'d2
n. B\'b8o c\'b8o t\'b5i ch\'ddnh l\'cbp tr\'aan c\'ac s\'eb d\'e5n t\'ddch ph\'b6n \'b6nh t\'d7nh h\'d7nh t\'b5i ch\'ddnh c\'f1a doanh nghi\'d6p trong qu\'b8 kh\'f8, hi\'d6n t\'b9i v\'b5 t\'ad\'acng lai.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\b\f15\fs26 Ho\'b9t \'ae\'e9ng Li\'aan t\'f4c
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 04. B\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6i \'ae\'ad\'eec l\'cbp tr\'aan c\'ac s\'eb gi\'b6 \'ae\'denh l\'b5 doanh nghi\'d6p \'aeang ho\'b9t \'ae\'e9ng li\'aan t\'f4c v\'b5 s\'cf ti\'d5p t
\'f4c ho\'b9t \'ae\'e9ng kinh doanh b\'d7nh th\'ad\'eang trong t\'ad\'acng lai g\'c7n, ngh\'dca l\'b5 doanh nghi\'d6p kh\'abng c\'e3 \'fd \'ae\'denh c\'f2ng nh\'ad kh\'abng bu\'e9c ph\'b6i ng\'f5ng ho\'b9t \'ae\'e9ng ho\'c6c ph\'b6i thu h\'d1p \'ae\'b8
ng k\'d3 quy m\'ab ho\'b9t \'ae\'e9ng c\'f1a m\'d7nh. Tr\'ad\'eang h\'eep th\'f9c t\'d5 kh\'b8c v\'edi gi\'b6 \'ae\'denh ho\'b9t \'ae\'e9ng li\'aan t\'f4c th\'d7 b\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6i l\'cbp tr\'aan m\'e9t c\'ac s\'eb kh\'b8c v\'b5 ph\'b6
i gi\'b6i th\'ddch c\'ac s\'eb \'ae\'b7 s\'f6 d\'f4ng \'ae\'d3 l\'cbp b\'b8o c\'b8o t\'b5i ch\'ddnh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Gi\'b8 g\'e8c
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 05. T\'b5i s\'b6n ph\'b6i \'ae\'ad\'eec ghi nh\'cbn theo gi\'b8 g\'e8c. Gi\'b8 g\'e8c c\'f1a t\'b5i s\'b6n \'ae\'ad\'eec t\'ddnh theo s\'e8 ti\'d2n ho\'c6c kho\'b6n t\'ad\'acng \'ae\'ad
\'acng ti\'d2n \'ae\'b7 tr\'b6, ph\'b6i tr\'b6 ho\'c6c t\'ddnh theo gi\'b8 tr\'de h\'eep l\'fd c\'f1a t\'b5i s\'b6n \'ae\'e3 v\'b5o th\'eai \'aei\'d3m t\'b5i s\'b6n \'ae\'ad\'eec ghi nh\'cbn. Gi\'b8 g\'e8c c\'f1a t\'b5i s\'b6n kh\'abng \'ae\'ad\'eec thay 
\'ae\'e6i tr\'f5 khi c\'e3 quy \'ae\'denh kh\'b8c trong chu\'c8n m\'f9c k\'d5 to\'b8n c\'f4 th\'d3.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Ph\'ef h\'eep
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 06. Vi\'d6c ghi nh\'cbn doanh thu v\'b5 chi ph\'dd ph\'b6i ph\'ef h\'eep v\'edi nhau. Khi ghi nh\'cbn m\'e9t kho\'b6n doanh thu th\'d7 ph\'b6i ghi nh\'cbn m\'e9t kho\'b6n chi ph\'dd t
\'ad\'acng \'f8ng c\'e3 li\'aan quan \'ae\'d5n vi\'d6c t\'b9o ra doanh thu \'ae\'e3. Chi ph\'dd t\'ad\'acng \'f8ng v\'edi doanh thu g\'e5m chi ph\'dd c\'f1a k\'fa t\'b9o ra doanh thu v\'b5 chi ph\'dd c\'f1a c\'b8c k\'fa tr\'ad\'edc ho\'c6c chi ph\'dd ph
\'b6i tr\'b6 nh\'adng li\'aan quan \'ae\'d5n doanh thu c\'f1a k\'fa \'ae\'e3.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Nh\'cat qu\'b8n
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 07. C\'b8c ch\'ddnh s\'b8ch v\'b5 ph\'ad\'acng ph\'b8p k\'d5 to\'b8n doanh nghi\'d6p \'ae\'b7 ch\'e4n ph\'b6i \'ae\'ad\'eec \'b8p d\'f4ng th\'e8ng nh\'cat \'ddt nh\'cat trong m\'e9t k
\'fa k\'d5 to\'b8n n\'a8m. Tr\'ad\'eang h\'eep c\'e3 thay \'ae\'e6i ch\'ddnh s\'b8ch v\'b5 ph\'ad\'acng ph\'b8p k\'d5 to\'b8n \'ae\'b7 ch\'e4n th\'d7 ph\'b6i gi\'b6i tr\'d7nh l\'fd do v\'b5 \'b6nh h\'ad\'ebng c\'f1a s\'f9 thay \'ae\'e6i \'ae\'e3 trong ph
\'c7n thuy\'d5t minh b\'b8o c\'b8o t\'b5i ch\'ddnh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Th\'cbn tr\'e4ng
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 08. Th\'cbn tr\'e4ng l\'b5 vi\'d6c xem x\'d0t, c\'a9n nh\'bec, ph\'b8n \'aeo\'b8n c\'c7n thi\'d5t \'ae\'d3 l\'cbp c\'b8c \'ad\'edc t\'ddnh k\'d5 to\'b8n trong c\'b8c \'aei\'d2u ki\'d6
n kh\'abng ch\'bec ch\'ben. Nguy\'aan t\'bec th\'cbn tr\'e4ng \'ae\'dfi h\'e1i:
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\f15\fs26 a/ Ph\'b6i l\'cbp c\'b8c kho\'b6n d\'f9 ph\'dfng nh\'adng kh\'abng l\'cbp qu\'b8 l\'edn;
\par }{\f15 
\par }{\f15\fs26 b/ Kh\'abng \'ae\'b8nh gi\'b8 cao h\'acn gi\'b8 tr\'de c\'f1a c\'b8c t\'b5i s\'b6n v\'b5 c\'b8c kho\'b6n thu nh\'cbp;
\par }{\f15 
\par }{\f15\fs26 c/ Kh\'abng \'ae\'b8nh gi\'b8 th\'cap h\'acn gi\'b8 tr\'de c\'f1a c\'b8c kho\'b6n n\'ee ph\'b6i tr\'b6 v\'b5 chi ph\'dd;
\par }{\f15 
\par }{\f15\fs26 d/ Doanh thu v\'b5 thu nh\'cbp ch\'d8 \'ae\'ad\'eec ghi nh\'cbn khi c\'e3 b\'bbng ch\'f8ng ch\'bec ch\'ben v\'d2 kh\'b6 n\'a8ng thu \'ae\'ad\'eec l\'eei \'ddch kinh t\'d5, c\'dfn chi ph\'dd ph\'b6i \'ae\'ad\'eec ghi nh\'cbn khi c\'e3 b\'bb
ng ch\'f8ng v\'d2 kh\'b6 n\'a8ng ph\'b8t sinh chi ph\'dd.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par 
\par }{\b\f15\fs26 Tr\'e4ng y\'d5u
\par }{\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 09. Th\'abng tin \'ae\'ad\'eec coi l\'b5 tr\'e4ng y\'d5u trong tr\'ad\'eang h\'eep n\'d5u thi\'d5u th\'abng tin  ho\'c6c thi\'d5u ch\'ddnh x\'b8c c\'f1a th\'abng tin \'ae\'e3 c\'e3 th
\'d3 l\'b5m sai l\'d6ch \'ae\'b8ng k\'d3 b\'b8o c\'b8o t\'b5i ch\'ddnh, l\'b5m \'b6nh h\'ad\'ebng \'ae\'d5n quy\'d5t \'ae\'denh kinh t\'d5 c\'f1a ng\'ad\'eai s\'f6 d\'f4ng b\'b8o c\'b8o t\'b5i ch\'ddnh. T\'ddnh tr\'e4ng y\'d5u ph\'f4 thu\'e9c v\'b5o \'ae
\'e9 l\'edn v\'b5 t\'ddnh ch\'cat c\'f1a th\'abng tin ho\'c6c c\'b8c sai s\'e3t \'ae\'ad\'eec \'ae\'b8nh gi\'b8 trong ho\'b5n c\'b6nh c\'f4 th\'d3. T\'ddnh tr\'e4ng y\'d5u c\'f1a th\'abng tin ph\'b6i \'ae\'ad\'eec xem x\'d0t tr\'aan c\'b6 ph\'ad\'acng di
\'d6n \'ae\'denh l\'ad\'eeng v\'b5 \'ae\'denh t\'ddnh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs24 
\par }{\b\f20\fs22 c\'b8c y\'aau c\'c7u c\'ac b\'b6n \'ae\'e8i v\'edi  k\'d5 to\'b8n
\par }{\f15\fs24 
\par }{\b\f15\fs26 Trung th\'f9c
\par }{\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 10. C\'b8c th\'abng tin v\'b5 s\'e8 li\'d6u k\'d5 to\'b8n ph\'b6i \'ae\'ad\'eec ghi ch\'d0p v\'b5 b\'b8o c\'b8o tr\'aan c\'ac s\'eb c\'b8c b\'bbng ch\'f8ng \'ae\'c7y \'ae\'f1, kh\'b8
ch quan v\'b5 \'ae\'f3ng v\'edi th\'f9c t\'d5 v\'d2 hi\'d6n tr\'b9ng, b\'b6n ch\'cat n\'e9i dung v\'b5 gi\'b8 tr\'de c\'f1a nghi\'d6p v\'f4 kinh t\'d5 ph\'b8t sinh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs24 
\par }{\b\f15\fs26 Kh\'b8ch quan
\par }{\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 11. C\'b8c th\'abng tin v\'b5 s\'e8 li\'d6u k\'d5 to\'b8n ph\'b6i \'ae\'ad\'eec ghi ch\'d0p v\'b5 b\'b8o c\'b8o \'ae\'f3ng v\'edi th\'f9c t\'d5, kh\'abng b\'de xuy\'aan t\'b9c, kh\'ab
ng b\'de b\'e3p m\'d0o.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs24 
\par }{\b\f15\fs26 \'a7\'c7y \'ae\'f1   
\par }{\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 12. M\'e4i nghi\'d6p v\'f4 kinh t\'d5, t\'b5i ch\'ddnh ph\'b8t sinh li\'aan quan \'ae\'d5n k\'fa k\'d5 to\'b8n ph\'b6i \'ae\'ad\'eec ghi ch\'d0p v\'b5 b\'b8o c\'b8o \'ae\'c7y \'ae\'f1
, kh\'abng b\'de b\'e1 s\'e3t. 
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs24 
\par }{\b\f15\fs26 K\'dep th\'eai
\par }{\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 13. C\'b8c th\'abng tin v\'b5 s\'e8 li\'d6u k\'d5 to\'b8n ph\'b6i \'ae\'ad\'eec ghi ch\'d0p v\'b5 b\'b8o c\'b8o k\'dep th\'eai, \'ae\'f3ng ho\'c6c tr\'ad\'edc th\'eai h\'b9n quy \'ae\'de
nh, kh\'abng \'ae\'ad\'eec ch\'cbm tr\'d4.     
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs24 
\par }{\b\f15\fs26 D\'d4 hi\'d3u
\par }{\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 14. C\'b8c th\'abng tin v\'b5 s\'e8 li\'d6u k\'d5 to\'b8n tr\'d7nh b\'b5y trong b\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6i r\'e2 r\'b5ng, d\'d4 hi\'d3u \'ae\'e8i v\'edi ng\'ad\'eai s\'f6 d
\'f4ng. Ng\'ad\'eai s\'f6 d\'f4ng \'eb \'ae\'a9y \'ae\'ad\'eec hi\'d3u l\'b5 ng\'ad\'eai c\'e3 hi\'d3u bi\'d5t v\'d2 kinh doanh, v\'d2 kinh t\'d5, t\'b5i ch\'ddnh, k\'d5 to\'b8n \'eb m\'f8c trung b\'d7nh. Th\'abng tin v\'d2 nh\'f7ng v\'can \'ae\'d2 ph\'f8
c t\'b9p trong b\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6i \'ae\'ad\'eec gi\'b6i tr\'d7nh trong ph\'c7n thuy\'d5t minh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs24 
\par }{\b\f15\fs26 C\'e3 th\'d3 so s\'b8nh
\par }{\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 15. C\'b8c th\'abng tin v\'b5 s\'e8 li\'d6u k\'d5 to\'b8n gi\'f7a c\'b8c k\'fa k\'d5 to\'b8n trong m\'e9t doanh nghi\'d6p v\'b5 gi\'f7a c\'b8c doanh nghi\'d6p ch\'d8 c\'e3 th\'d3 so s
\'b8nh \'ae\'ad\'eec khi t\'ddnh to\'b8n v\'b5 tr\'d7nh b\'b5y nh\'cat qu\'b8n. Tr\'ad\'eang h\'eep kh\'abng nh\'cat qu\'b8n th\'d7 ph\'b6i gi\'b6i tr\'d7nh trong ph\'c7n thuy\'d5t minh \'ae\'d3 ng\'ad\'eai s\'f6 d\'f4ng b\'b8o c\'b8o t\'b5i ch\'ddnh c
\'e3 th\'d3 so s\'b8nh th\'abng tin gi\'f7a c\'b8c k\'fa k\'d5 to\'b8n, gi\'f7a c\'b8c doanh nghi\'d6p ho\'c6c gi\'f7a th\'abng tin th\'f9c hi\'d6n v\'edi th\'abng tin d\'f9 to\'b8n, k\'d5 ho\'b9ch.
\par 16. Y\'aau c\'c7u k\'d5 to\'b8n quy \'ae\'denh t\'b9i c\'b8c \'a7o\'b9n 10, 11, 12, 13, 14, 15 n\'e3i tr\'aan ph\'b6i \'ae\'ad\'eec th\'f9c hi\'d6n \'ae\'e5ng th\'eai. V\'dd d\'f4: Y\'aau c\'c7u trung th\'f9c \'ae\'b7 bao h\'b5m y\'aau c\'c7u kh\'b8
ch quan; y\'aau c\'c7u k\'dep th\'eai nh\'adng ph\'b6i \'ae\'c7y \'ae\'f1, d\'d4 hi\'d3u v\'b5 c\'e3 th\'d3 so s\'b8nh \'ae\'ad\'eec.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard\plain \s9\qj\keepn\nowidctlpar\widctlpar\outlinelevel8\adjustright \b\f20\fs22\cgrid {C\'b8c y\'d5u t\'e8 c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh
\par }\pard\plain \qj\nowidctlpar\widctlpar\adjustright \fs20\cgrid {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 17. B\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6n \'b6nh t\'d7nh h\'d7nh t\'b5i ch\'ddnh c\'f1a doanh nghi\'d6p b\'bbng c\'b8ch t\'e6ng h\'eep c\'b8c nghi\'d6p v\'f4 kinh t\'d5, t\'b5i ch\'dd
nh c\'e3 c\'efng t\'ddnh ch\'cat kinh t\'d5 th\'b5nh c\'b8c y\'d5u t\'e8 c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh. C\'b8c y\'d5u t\'e8 li\'aan quan tr\'f9c ti\'d5p \'ae\'d5n vi\'d6c x\'b8c \'ae\'denh t\'d7nh h\'d7nh t\'b5i ch\'ddnh trong B\'b6ng c\'a9n \'ae
\'e8i k\'d5 to\'b8n l\'b5 T\'b5i s\'b6n, N\'ee ph\'b6i tr\'b6 v\'b5 V\'e8n ch\'f1 s\'eb h\'f7u. C\'b8c y\'d5u t\'e8 li\'aan quan tr\'f9c ti\'d5p \'ae\'d5n \'ae\'b8nh gi\'b8 t\'d7nh h\'d7nh v\'b5 k\'d5t qu\'b6 kinh doanh trong B\'b8o c\'b8o k\'d5t qu\'b6
 ho\'b9t \'ae\'e9ng kinh doanh l\'b5 Doanh thu, thu nh\'cbp kh\'b8c, Chi ph\'dd v\'b5 K\'d5t qu\'b6 kinh doanh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }{\b\f15\fs26 T\'d7nh h\'d7nh t\'b5i ch\'ddnh
\par }{\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 18. C\'b8c y\'d5u t\'e8 c\'e3 li\'aan quan tr\'f9c ti\'d5p t\'edi vi\'d6c x\'b8c \'ae\'denh v\'b5 \'ae\'b8nh gi\'b8 t\'d7nh h\'d7nh t\'b5i ch\'ddnh l\'b5 T\'b5i s\'b6n, N\'ee ph\'b6i tr
\'b6 v\'b5 V\'e8n ch\'f1 s\'eb h\'f7u. Nh\'f7ng y\'d5u t\'e8 n\'b5y \'ae\'ad\'eec \'ae\'denh ngh\'dca nh\'ad sau:
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs16 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\f15\fs26 a/ T\'b5i s\'b6n: L\'b5 ngu\'e5n l\'f9c do doanh nghi\'d6p ki\'d3m so\'b8t v\'b5 c\'e3 th\'d3 thu \'ae\'ad\'eec l\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai.
\par }{\f15\fs16 
\par }{\f15\fs26 b/ N\'ee ph\'b6i tr\'b6: L\'b5 ngh\'dca v\'f4 hi\'d6n t\'b9i c\'f1a doanh nghi\'d6p ph\'b8t sinh t\'f5 c\'b8c giao d\'dech v\'b5 s\'f9 ki\'d6n \'ae\'b7 qua m\'b5 doanh nghi\'d6p ph\'b6i thanh to\'b8n t\'f5 c\'b8c ngu\'e5n l\'f9c c\'f1a m\'d7
nh.
\par }{\f15\fs16 
\par }{\f15\fs26 c/ V\'e8n ch\'f1 s\'eb h\'f7u: L\'b5 gi\'b8 tr\'de v\'e8n c\'f1a doanh nghi\'d6p, \'ae\'ad\'eec t\'ddnh b\'bbng s\'e8 ch\'aanh l\'d6ch gi\'f7a gi\'b8 tr\'de T\'b5i s\'b6n c\'f1a doanh nghi\'d6p tr\'f5 (-) N\'ee ph\'b6i tr\'b6.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 19. Khi x\'b8c \'ae\'denh c\'b8c kho\'b6n m\'f4c trong c\'b8c y\'d5u t\'e8 c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6i ch\'f3 \'fd \'ae\'d5n h\'d7nh th\'f8c s\'eb h\'f7u v\'b5 n\'e9
i dung kinh t\'d5 c\'f1a ch\'f3ng. Trong m\'e9t s\'e8 tr\'ad\'eang h\'eep, t\'b5i s\'b6n kh\'abng thu\'e9c quy\'d2n s\'eb h\'f7u c\'f1a doanh nghi\'d6p nh\'adng c\'a8n c\'f8 v\'b5o n\'e9i dung kinh t\'d5 c\'f1a t\'b5i s\'b6n th\'d7 \'ae\'ad\'eec ph\'b6n 
\'b6nh trong c\'b8c y\'d5u t\'e8 c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh. V\'dd d\'f4, tr\'ad\'eang h\'eep thu\'aa t\'b5i ch\'ddnh, h\'d7nh th\'f8c v\'b5 n\'e9i dung kinh t\'d5 l\'b5 vi\'d6c doanh nghi\'d6p \'aei thu\'aa thu \'ae\'ad\'eec l\'eei \'dd
ch kinh t\'d5 t\'f5 vi\'d6c s\'f6 d\'f4ng t\'b5i s\'b6n thu\'aa \'ae\'e8i v\'edi ph\'c7n l\'edn th\'eai gian s\'f6 d\'f4ng h\'f7u \'ddch c\'f1a t\'b5i s\'b6n, \'ae\'e6i l\'b9i doanh nghi\'d6p \'aei thu\'aa c\'e3 ngh\'dca v\'f4 ph\'b6i tr\'b6 m\'e9t kho
\'b6n ti\'d2n x\'cap x\'d8 v\'edi gi\'b8 tr\'de h\'eep l\'fd c\'f1a t\'b5i s\'b6n v\'b5 c\'b8c chi ph\'dd t\'b5i ch\'ddnh c\'e3 li\'aan quan. Nghi\'d6p v\'f4 thu\'aa t\'b5i ch\'ddnh l\'b5m ph\'b8t sinh kho\'b6n m\'f4c "T\'b5i s\'b6n" v\'b5 kho\'b6n m\'f4
c "N\'ee ph\'b6i tr\'b6" trong B\'b6ng c\'a9n \'ae\'e8i k\'d5 to\'b8n c\'f1a doanh nghi\'d6p \'aei thu\'aa.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }{\b\i\f15\fs26 T\'b5i s\'b6n
\par }{\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 20. L\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai c\'f1a m\'e9t t\'b5i s\'b6n l\'b5 ti\'d2m n\'a8ng l\'b5m t\'a8ng ngu\'e5n ti\'d2n v\'b5 c\'b8c kho\'b6n t\'ad\'acng \'ae\'ad\'acng ti
\'d2n c\'f1a doanh nghi\'d6p ho\'c6c l\'b5m gi\'b6m b\'edt c\'b8c kho\'b6n ti\'d2n m\'b5 doanh nghi\'d6p ph\'b6i chi ra.
\par 
\par 21. L\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai c\'f1a m\'e9t t\'b5i s\'b6n \'ae\'ad\'eec th\'d3 hi\'d6n trong c\'b8c tr\'ad\'eang h\'eep, nh\'ad:
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs16 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\f15\fs26 a/ \'a7\'ad\'eec s\'f6 d\'f4ng m\'e9t c\'b8ch \'ae\'acn l\'ce ho\'c6c k\'d5t h\'eep v\'edi c\'b8c t\'b5i s\'b6n kh\'b8c trong s\'b6n xu\'cat s\'b6n ph\'c8m \'ae\'d3 b\'b8n hay cung c\'ca
p d\'dech v\'f4 cho kh\'b8ch h\'b5ng;
\par }{\f15\fs16 
\par }{\f15\fs26 b/ \'a7\'d3 b\'b8n ho\'c6c trao \'ae\'e6i l\'cay t\'b5i s\'b6n kh\'b8c;
\par }{\f15\fs16 
\par }{\f15\fs26 c/ \'a7\'d3 thanh to\'b8n c\'b8c kho\'b6n n\'ee ph\'b6i tr\'b6;
\par }{\f15\fs16 
\par }{\f15\fs26 d/ \'a7\'d3 ph\'a9n ph\'e8i cho c\'b8c ch\'f1 s\'eb h\'f7u doanh nghi\'d6p.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 22. T\'b5i s\'b6n \'ae\'ad\'eec bi\'d3u hi\'d6n d\'ad\'edi h\'d7nh th\'b8i v\'cbt ch\'cat nh\'ad nh\'b5 x\'ad\'ebng, m\'b8y m\'e3c, thi\'d5t b\'de, v\'cbt t\'ad, h\'b5ng ho\'b8 ho\'c6
c kh\'abng th\'d3 hi\'d6n d\'ad\'edi h\'d7nh th\'b8i v\'cbt ch\'cat nh\'ad b\'b6n quy\'d2n, b\'bbng s\'b8ng ch\'d5 nh\'adng ph\'b6i thu \'ae\'ad\'eec l\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai v\'b5 thu\'e9c quy\'d2n ki\'d3m so\'b8t c\'f1a doanh nghi
\'d6p.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 23. T\'b5i s\'b6n c\'f1a doanh nghi\'d6p c\'dfn bao g\'e5m c\'b8c t\'b5i s\'b6n kh\'abng thu\'e9c quy\'d2n s\'eb h\'f7u c\'f1a doanh nghi\'d6p nh\'adng doanh nghi\'d6p ki\'d3m so\'b8t 
\'ae\'ad\'eec v\'b5 thu \'ae\'ad\'eec l\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai, nh\'ad t\'b5i s\'b6n thu\'aa t\'b5i ch\'ddnh; ho\'c6c c\'e3 nh\'f7ng t\'b5i s\'b6n thu\'e9c quy\'d2n s\'eb h\'f7u c\'f1a doanh nghi\'d6p v\'b5 thu \'ae\'ad\'eec l\'eei 
\'ddch kinh t\'d5 trong t\'ad\'acng lai nh\'adng c\'e3 th\'d3 kh\'abng ki\'d3m so\'b8t \'ae\'ad\'eec v\'d2 m\'c6t ph\'b8p l\'fd, nh\'ad b\'dd quy\'d5t k\'fc thu\'cbt thu \'ae\'ad\'eec t\'f5 ho\'b9t \'ae\'e9ng tri\'d3n khai c\'e3 th\'d3 th\'e1a m\'b7n c
\'b8c \'aei\'d2u ki\'d6n trong \'ae\'denh ngh\'dca v\'d2 t\'b5i s\'b6n khi c\'b8c b\'dd quy\'d5t \'ae\'e3 c\'dfn gi\'f7 \'ae\'ad\'eec b\'dd m\'cbt v\'b5 doanh nghi\'d6p c\'dfn thu \'ae\'ad\'eec l\'eei \'ddch kinh t\'d5.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 24. T\'b5i s\'b6n c\'f1a doanh nghi\'d6p \'ae\'ad\'eec h\'d7nh th\'b5nh t\'f5 c\'b8c giao d\'dech ho\'c6c c\'b8c s\'f9 ki\'d6n \'ae\'b7 qua, nh\'ad g\'e3p v\'e8n, mua s\'bem, t\'f9 s\'b6
n xu\'cat, \'ae\'ad\'eec c\'cap, \'ae\'ad\'eec bi\'d5u t\'c6ng. C\'b8c giao d\'dech ho\'c6c c\'b8c s\'f9 ki\'d6n d\'f9 ki\'d5n s\'cf ph\'b8t sinh trong t\'ad\'acng lai kh\'abng l\'b5m t\'a8ng t\'b5i s\'b6n.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 25. Th\'abng th\'ad\'eang khi c\'b8c kho\'b6n chi ph\'dd ph\'b8t sinh s\'cf t\'b9o ra t\'b5i s\'b6n. \'a7\'e8i v\'edi c\'b8c kho\'b6n chi ph\'dd kh\'abng t\'b9o ra l\'eei \'ddch kinh t
\'d5 trong t\'ad\'acng lai th\'d7 kh\'abng t\'b9o ra t\'b5i s\'b6n; Ho\'c6c c\'e3 tr\'ad\'eang h\'eep kh\'abng ph\'b8t sinh chi ph\'dd nh\'adng v\'c9n t\'b9o ra t\'b5i s\'b6n, nh\'ad v\'e8n g\'e3p, t\'b5i s\'b6n \'ae\'ad\'eec c\'cap, \'ae\'ad\'eec bi\'d5
u t\'c6ng.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }{\b\i\f15\fs26 N\'ee ph\'b6i tr\'b6
\par }{\f15\fs22 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 26. N\'ee ph\'b6i tr\'b6 x\'b8c \'ae\'denh ngh\'dca v\'f4 hi\'d6n t\'b9i c\'f1a doanh nghi\'d6p khi doanh nghi\'d6p nh\'cbn v\'d2 m\'e9t t\'b5i s\'b6n, tham gia m\'e9t cam k\'d5t ho\'c6
c ph\'b8t sinh c\'b8c ngh\'dca v\'f4 ph\'b8p l\'fd.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }{\f15\fs26 27. Vi\'d6c thanh to\'b8n c\'b8c ngh\'dca v\'f4 hi\'d6n t\'b9i c\'e3 th\'d3 \'ae\'ad\'eec th\'f9c hi\'d6n b\'bbng nhi\'d2u c\'b8ch, nh\'ad:
\par }{\f15\fs14 
\par }\pard \qj\fi426\nowidctlpar\widctlpar\adjustright {\f15\fs26 a/ Tr\'b6 b\'bbng ti\'d2n;
\par }{\f15\fs14 
\par }{\f15\fs26 b/ Tr\'b6 b\'bbng t\'b5i s\'b6n kh\'b8c;
\par }{\f15\fs14 
\par }{\f15\fs26 c/ Cung c\'cap d\'dech v\'f4;
\par }{\f15\fs14 
\par }{\f15\fs26 d/ Thay th\'d5 ngh\'dca v\'f4 n\'b5y b\'bbng ngh\'dca v\'f4 kh\'b8c;
\par }{\f15\fs14 
\par }{\f15\fs26 \'ae/ Chuy\'d3n \'ae\'e6i ngh\'dca v\'f4 n\'ee ph\'b6i tr\'b6 th\'b5nh v\'e8n ch\'f1 s\'eb h\'f7u.
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs22 
\par }{\f15\fs26 28. N\'ee ph\'b6i tr\'b6 ph\'b8t sinh t\'f5 c\'b8c giao d\'dech v\'b5 s\'f9 ki\'d6n \'ae\'b7 qua, nh\'ad mua h\'b5ng ho\'b8 ch\'ada tr\'b6 ti\'d2n, s\'f6 d\'f4ng d\'dech v\'f4 ch\'ada thanh to\'b8n, vay n\'ee, cam k\'d5t b\'b6o h\'b5nh h\'b5
ng ho\'b8, cam k\'d5t ngh\'dca v\'f4 h\'eep \'ae\'e5ng, ph\'b6i tr\'b6 nh\'a9n vi\'aan, thu\'d5 ph\'b6i n\'e9p, ph\'b6i tr\'b6 kh\'b8c.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\b\i\f15\fs26 V\'e8n ch\'f1 s\'eb h\'f7u
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 29. V\'e8n ch\'f1 s\'eb h\'f7u \'ae\'ad\'eec ph\'b6n \'b6nh trong B\'b6ng c\'a9n \'ae\'e8i k\'d5 to\'b8n, g\'e5m: v\'e8n c\'f1a c\'b8c nh\'b5 \'ae\'c7u t\'ad, th\'c6ng d\'ad v\'e8n c\'e6
 ph\'c7n, l\'eei nhu\'cbn gi\'f7 l\'b9i, c\'b8c qu\'fc, l\'eei nhu\'cbn ch\'ada ph\'a9n ph\'e8i, ch\'aanh l\'d6ch t\'fb gi\'b8 v\'b5 ch\'aanh l\'d6ch \'ae\'b8nh gi\'b8 l\'b9i t\'b5i s\'b6n.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs16 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\f15\fs26 a/ V\'e8n c\'f1a c\'b8c nh\'b5 \'ae\'c7u t\'ad c\'e3 th\'d3 l\'b5 v\'e8n c\'f1a ch\'f1 doanh nghi\'d6p, v\'e8n g\'e3p, v\'e8n c\'e6 ph\'c7n, v\'e8n Nh\'b5 n\'ad\'edc;
\par }{\f15\fs16 
\par }{\f15\fs26 b/ Th\'c6ng d\'ad v\'e8n c\'e6 ph\'c7n l\'b5 ch\'aanh l\'d6ch gi\'f7a m\'d6nh gi\'b8 c\'e6 phi\'d5u v\'edi gi\'b8 th\'f9c t\'d5 ph\'b8t h\'b5nh;
\par }{\f15\fs16 
\par }{\f15\fs26 c/ L\'eei nhu\'cbn gi\'f7 l\'b9i l\'b5 l\'eei nhu\'cbn sau thu\'d5 gi\'f7 l\'b9i \'ae\'d3 t\'ddch lu\'fc b\'e6 sung v\'e8n;
\par }{\f15\fs16 
\par }{\f15\fs26 d/ C\'b8c qu\'fc nh\'ad qu\'fc d\'f9 tr\'f7, qu\'fc d\'f9 ph\'dfng, qu\'fc \'ae\'c7u t\'ad ph\'b8t tri\'d3n;
\par }{\f15\fs16 
\par }{\f15\fs26 \'ae/ L\'eei nhu\'cbn ch\'ada ph\'a9n ph\'e8i l\'b5 l\'eei nhu\'cbn sau thu\'d5 ch\'ada chia cho ch\'f1 s\'eb h\'f7u ho\'c6c ch\'ada tr\'ddch l\'cbp c\'b8c qu\'fc;
\par }{\f15\fs16 
\par }{\f15\fs26 e/ Ch\'aanh l\'d6ch t\'fb gi\'b8, g\'e5m:
\par }\pard \qj\fi-284\li993\nowidctlpar\widctlpar\adjustright {\f15\fs8 
\par }{\f15\fs26 + Ch\'aanh l\'d6ch t\'fb gi\'b8 ph\'b8t sinh trong qu\'b8 tr\'d7nh \'ae\'c7u t\'ad x\'a9y d\'f9ng;
\par }{\f15\fs8 
\par }{\f15\fs26 + Ch\'aanh l\'d6ch t\'fb gi\'b8 ph\'b8t sinh khi doanh nghi\'d6p \'eb trong n\'ad\'edc h\'eep nh\'cat b\'b8o c\'b8o t\'b5i ch\'ddnh c\'f1a c\'b8c ho\'b9t \'ae\'e9ng \'eb n\'ad\'edc ngo\'b5i s\'f6 d\'f4ng \'ae\'acn v\'de ti\'d2n t\'d6 k\'d5 to
\'b8n kh\'b8c v\'edi \'ae\'acn v\'de ti\'d2n t\'d6 k\'d5 to\'b8n c\'f1a doanh nghi\'d6p b\'b8o c\'b8o.
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\f15\fs16 
\par }{\f15\fs26 g/ Ch\'aanh l\'d6ch \'ae\'b8nh gi\'b8 l\'b9i t\'b5i s\'b6n l\'b5 ch\'aanh l\'d6ch gi\'f7a gi\'b8 tr\'de ghi s\'e6 c\'f1a t\'b5i s\'b6n v\'edi gi\'b8 tr\'de \'ae\'b8nh gi\'b8 l\'b9i t\'b5i s\'b6n khi c\'e3 quy\'d5t \'ae\'denh c\'f1a Nh\'b5 n
\'ad\'edc, ho\'c6c khi \'ae\'ada t\'b5i s\'b6n \'aei g\'e3p v\'e8n li\'aan doanh, c\'e6 ph\'c7n.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26  
\par }{\b\f15\fs26 T\'d7nh h\'d7nh kinh doanh
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 30. L\'eei nhu\'cbn l\'b5 th\'ad\'edc \'aeo k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh c\'f1a doanh nghi\'d6p. C\'b8c y\'d5u t\'e8 li\'aan quan tr\'f9c ti\'d5p \'ae\'d5n vi\'d6c x\'b8c 
\'ae\'denh l\'eei nhu\'cbn l\'b5 Doanh thu, thu nh\'cbp kh\'b8c v\'b5 Chi ph\'dd. Doanh thu, thu nh\'cbp kh\'b8c, Chi ph\'dd v\'b5 L\'eei nhu\'cbn l\'b5 c\'b8c ch\'d8 ti\'aau ph\'b6n \'b8nh t\'d7nh h\'d7nh kinh doanh c\'f1a doanh nghi\'d6p.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par 31. C\'b8c y\'d5u t\'e8 Doanh thu, thu nh\'cbp kh\'b8c v\'b5 Chi ph\'dd \'ae\'ad\'eec \'ae\'denh ngh\'dca nh\'ad sau:
\par }{\f15\fs16 
\par }\pard \qj\fi-283\li709\nowidctlpar\widctlpar\adjustright {\f15\fs26 a/ Doanh thu v\'b5 thu nh\'cbp kh\'b8c: L\'b5 t\'e6ng gi\'b8 tr\'de c\'b8c l\'eei \'ddch kinh t\'d5 doanh nghi\'d6p thu \'ae\'ad\'eec trong k\'fa k\'d5 to\'b8n, ph\'b8t sinh t\'f5 c\'b8
c ho\'b9t \'ae\'e9ng s\'b6n xu\'cat, kinh doanh th\'abng th\'ad\'eang v\'b5 c\'b8c ho\'b9t \'ae\'e9ng kh\'b8c c\'f1a doanh nghi\'d6p, g\'e3p ph\'c7n l\'b5m t\'a8ng v\'e8n ch\'f1 s\'eb h\'f7u, kh\'abng bao g\'e5m kho\'b6n g\'e3p v\'e8n c\'f1a c\'e6 \'ae
\'abng ho\'c6c ch\'f1 s\'eb h\'f7u.
\par }{\f15\fs16 
\par }{\f15\fs26 b/ Chi ph\'dd: L\'b5 t\'e6ng gi\'b8 tr\'de c\'b8c kho\'b6n l\'b5m gi\'b6m l\'eei \'ddch kinh t\'d5 trong k\'fa k\'d5 to\'b8n d\'ad\'edi h\'d7nh th\'f8c c\'b8c kho\'b6n ti\'d2n chi ra, c\'b8c kho\'b6n kh\'cau tr\'f5 t\'b5i s\'b6n ho\'c6c ph\'b8
t sinh c\'b8c kho\'b6n n\'ee d\'c9n \'ae\'d5n l\'b5m gi\'b6m v\'e8n ch\'f1 s\'eb h\'f7u, kh\'abng bao g\'e5m kho\'b6n ph\'a9n ph\'e8i cho c\'e6 \'ae\'abng ho\'c6c ch\'f1 s\'eb h\'f7u.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs24 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 32. Doanh thu, thu nh\'cbp kh\'b8c v\'b5 chi ph\'dd \'ae\'ad\'eec tr\'d7nh b\'b5y trong B\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng}{\f15\fs22  }{\f15\fs26 kinh}{\f15\fs22  }{
\f15\fs26 doanh}{\f15\fs22  }{\f15\fs26 \'ae\'d3}{\f15\fs22  }{\f15\fs26 cung}{\f15\fs22  }{\f15\fs26 c\'cap}{\f15\fs22  }{\f15\fs26 th\'abng}{\f15\fs22  }{\f15\fs26 tin}{\f15\fs22  }{\f15\fs26 cho}{\f15\fs22  }{\f15\fs26 vi\'d6c}{\f15\fs22  }{\f15\fs26 
\'ae\'b8nh}{\f15\fs22  }{\f15\fs26 gi\'b8}{\f15\fs22  }{\f15\fs26 n\'a8ng}{\f15\fs22  }{\f15\fs26 l\'f9c c\'f1a doanh nghi\'d6p trong vi\'d6c t\'b9o ra c\'b8c ngu\'e5n ti\'d2n v\'b5 c\'b8c kho\'b6n t\'ad\'acng \'ae\'ad\'acng ti\'d2n trong t\'ad\'ac
ng lai. 
\par 
\par 33. C\'b8c y\'d5u t\'e8 doanh thu, thu nh\'cbp kh\'b8c v\'b5 chi ph\'dd c\'e3 th\'d3 tr\'d7nh b\'b5y theo nhi\'d2u c\'b8ch trong b\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh \'ae\'d3 tr\'d7nh b\'b5y t\'d7nh h\'d7nh kinh doanh c\'f1
a doanh nghi\'d6p, nh\'ad: Doanh thu, chi ph\'dd v\'b5 l\'eei nhu\'cbn c\'f1a ho\'b9t \'ae\'e9ng kinh doanh th\'abng th\'ad\'eang v\'b5 ho\'b9t \'ae\'e9ng kh\'b8c. 
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\i\f15\fs26 Doanh thu v\'b5 Thu nh\'cbp kh\'b8c
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 34. Doanh thu ph\'b8t sinh trong qu\'b8 tr\'d7nh ho\'b9t \'ae\'e9ng kinh doanh th\'abng th\'ad\'eang c\'f1a doanh nghi\'d6p v\'b5 th\'ad\'eang bao g\'e5m: Doanh thu b\'b8n h\'b5
ng, doanh thu cung c\'cap d\'dech v\'f4, ti\'d2n l\'b7i, ti\'d2n b\'b6n quy\'d2n, c\'e6 t\'f8c v\'b5 l\'eei nhu\'cbn \'ae\'ad\'eec chia...
\par 
\par 35. Thu nh\'cbp kh\'b8c bao g\'e5m c\'b8c kho\'b6n thu nh\'cbp ph\'b8t sinh t\'f5 c\'b8c ho\'b9t \'ae\'e9ng ngo\'b5i c\'b8c ho\'b9t \'ae\'e9ng t\'b9o ra doanh thu, nh\'ad: thu t\'f5 thanh l\'fd, nh\'ad\'eeng b\'b8n t\'b5i s\'b6n c\'e8 \'ae\'denh, thu ti
\'d2n ph\'b9t kh\'b8ch h\'b5ng do vi ph\'b9m h\'eep \'ae\'e5ng,...
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\i\f15\fs26 Chi ph\'dd
\par }{\f15\fs26          
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 36. Chi ph\'dd bao g\'e5m c\'b8c chi ph\'dd s\'b6n xu\'cat, kinh doanh ph\'b8t sinh trong qu\'b8 tr\'d7nh ho\'b9t \'ae\'e9ng kinh doanh th\'abng th\'ad\'eang c\'f1a doanh nghi\'d6p v\'b5
 c\'b8c chi ph\'dd kh\'b8c. 
\par 
\par 37. Chi ph\'dd s\'b6n xu\'cat, kinh doanh ph\'b8t sinh trong qu\'b8 tr\'d7nh ho\'b9t \'ae\'e9ng kinh doanh th\'abng th\'ad\'eang c\'f1a doanh nghi\'d6p, nh\'ad: gi\'b8 v\'e8n h\'b5ng b\'b8n, chi ph\'dd b\'b8n h\'b5ng, chi ph\'dd qu\'b6n l\'fd doanh nghi
\'d6p, chi ph\'dd l\'b7i ti\'d2n vay, v\'b5 nh\'f7ng chi ph\'dd li\'aan quan \'ae\'d5n ho\'b9t \'ae\'e9ng cho c\'b8c b\'aan kh\'b8c s\'f6 d\'f4ng t\'b5i s\'b6n sinh ra l\'eei t\'f8c, ti\'d2n b\'b6n quy\'d2n,... Nh\'f7ng chi ph\'dd n\'b5y ph\'b8t sinh d
\'ad\'edi d\'b9ng ti\'d2n v\'b5 c\'b8c kho\'b6n t\'ad\'acng \'ae\'ad\'acng ti\'d2n, h\'b5ng t\'e5n kho, kh\'cau hao m\'b8y m\'e3c, thi\'d5t b\'de.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 38. Chi ph\'dd kh\'b8c bao g\'e5m c\'b8c chi ph\'dd ngo\'b5i c\'b8c chi ph\'dd s\'b6n xu\'cat, kinh doanh ph\'b8t sinh trong qu\'b8 tr\'d7nh ho\'b9t \'ae\'e9ng kinh doanh th\'abng th\'ad
\'eang c\'f1a doanh nghi\'d6p, nh\'ad: chi ph\'dd v\'d2 thanh l\'fd, nh\'ad\'eeng b\'b8n t\'b5i s\'b6n c\'e8 \'ae\'denh, c\'b8c kho\'b6n ti\'d2n b\'de kh\'b8ch h\'b5ng ph\'b9t do vi ph\'b9m h\'eep \'ae\'e5ng,...
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f20\fs22 ghi nh\'cbn c\'b8c y\'d5u t\'e8 c\'f1a b\'b8o c\'b8o t\'b5i ch\'ddnh
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 39. B\'b8o c\'b8o t\'b5i ch\'ddnh ph\'b6i ghi nh\'cbn c\'b8c y\'d5u t\'e8 v\'d2 t\'d7nh h\'d7nh t\'b5i ch\'ddnh v\'b5 t\'d7nh h\'d7nh kinh doanh c\'f1a doanh nghi\'d6p; trong c\'b8c y
\'d5u t\'e8 \'ae\'e3 ph\'b6i \'ae\'ad\'eec ghi nh\'cbn theo t\'f5ng kho\'b6n m\'f4c. M\'e9t kho\'b6n m\'f4c \'ae\'ad\'eec ghi nh\'cbn trong b\'b8o c\'b8o t\'b5i ch\'ddnh khi tho\'b6 m\'b7n c\'b6 hai ti\'aau chu\'c8n:
\par }\pard \qj\fi426\nowidctlpar\widctlpar\adjustright {\f15\fs16 
\par }{\f15\fs26 a/ Ch\'bec ch\'ben thu \'ae\'ad\'eec l\'eei \'ddch kinh t\'d5 ho\'c6c l\'b5m gi\'b6m l\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai;
\par }{\f15\fs16 
\par }{\f15\fs26 b/ Kho\'b6n m\'f4c \'ae\'e3 c\'e3 gi\'b8 tr\'de v\'b5 x\'b8c \'ae\'denh \'ae\'ad\'eec gi\'b8 tr\'de m\'e9t c\'b8ch \'ae\'b8ng tin c\'cby.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Ghi nh\'cbn t\'b5i s\'b6n
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 40. T\'b5i s\'b6n \'ae\'ad\'eec ghi nh\'cbn trong B\'b6ng c\'a9n \'ae\'e8i k\'d5 to\'b8n khi doanh nghi\'d6p c\'e3 kh\'b6 n\'a8ng ch\'bec ch\'ben thu \'ae\'ad\'eec l\'eei \'ddch kinh t
\'d5 trong t\'ad\'acng lai v\'b5 gi\'b8 tr\'de c\'f1a t\'b5i s\'b6n \'ae\'e3 \'ae\'ad\'eec x\'b8c \'ae\'denh m\'e9t c\'b8ch \'ae\'b8ng tin c\'cby.
\par 
\par 41. T\'b5i s\'b6n kh\'abng \'ae\'ad\'eec ghi nh\'cbn trong B\'b6ng c\'a9n \'ae\'e8i k\'d5 to\'b8n khi c\'b8c chi ph\'dd b\'e1 ra kh\'abng ch\'bec ch\'ben s\'cf mang l\'b9i l\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai cho doanh nghi\'d6p th\'d7 c\'b8
c chi ph\'dd \'ae\'e3 \'ae\'ad\'eec ghi nh\'cbn ngay v\'b5o B\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh khi ph\'b8t sinh.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Ghi nh\'cbn n\'ee ph\'b6i tr\'b6   
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 42. N\'ee ph\'b6i tr\'b6 \'ae\'ad\'eec ghi nh\'cbn trong B\'b6ng c\'a9n \'ae\'e8i k\'d5 to\'b8n khi c\'e3 \'ae\'f1 \'aei\'d2u ki\'d6n ch\'bec ch\'ben l\'b5 doanh nghi\'d6p s\'cf ph\'b6
i d\'efng m\'e9t l\'ad\'eeng ti\'d2n chi ra \'ae\'d3 trang tr\'b6i cho nh\'f7ng ngh\'dca v\'f4 hi\'d6n t\'b9i m\'b5 doanh nghi\'d6p ph\'b6i thanh to\'b8n, v\'b5 kho\'b6n n\'ee ph\'b6i tr\'b6 \'ae\'e3 ph\'b6i x\'b8c \'ae\'denh \'ae\'ad\'eec m\'e9t c\'b8ch 
\'ae\'b8ng tin c\'cby. 
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Ghi nh\'cbn doanh thu v\'b5 thu nh\'cbp kh\'b8c
\par }{\f15\fs26 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 43. Doanh thu v\'b5 thu nh\'cbp kh\'b8c \'ae\'ad\'eec ghi nh\'cbn trong B\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh khi thu \'ae\'ad\'eec l\'eei \'ddch kinh t\'d5 trong t
\'ad\'acng lai c\'e3 li\'aan quan t\'edi s\'f9 gia t\'a8ng v\'d2 t\'b5i s\'b6n ho\'c6c gi\'b6m b\'edt n\'ee ph\'b6i tr\'b6 v\'b5 gi\'b8 tr\'de gia t\'a8ng \'ae\'e3 ph\'b6i x\'b8c \'ae\'denh \'ae\'ad\'eec m\'e9t c\'b8ch \'ae\'b8ng tin c\'cby. 
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
\par }{\b\f15\fs26 Ghi nh\'cbn chi ph\'dd
\par 
\par }\pard \qj\fi-426\li426\nowidctlpar\widctlpar\adjustright {\f15\fs26 44. Chi ph\'dd s\'b6n xu\'cat, kinh doanh v\'b5 chi ph\'dd kh\'b8c \'ae\'ad\'eec ghi nh\'cbn trong B\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh khi c\'b8c kho\'b6n chi ph
\'dd n\'b5y l\'b5m gi\'b6m b\'edt l\'eei \'ddch kinh t\'d5 trong t\'ad\'acng lai c\'e3 li\'aan quan \'ae\'d5n vi\'d6c gi\'b6m b\'edt t\'b5i s\'b6n ho\'c6c t\'a8ng n\'ee ph\'b6i tr\'b6 v\'b5 chi ph\'dd n\'b5y ph\'b6i x\'b8c \'ae\'denh \'ae\'ad\'eec m\'e9
t c\'b8ch \'ae\'b8ng tin c\'cby. 
\par 
\par 45. C\'b8c chi ph\'dd \'ae\'ad\'eec ghi nh\'cbn trong B\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh ph\'b6i tu\'a9n th\'f1 nguy\'aan t\'bec ph\'ef h\'eep gi\'f7a doanh thu v\'b5 chi ph\'dd.
\par 
\par 46. Khi l\'eei \'ddch kinh t\'d5 d\'f9 ki\'d5n thu \'ae\'ad\'eec trong nhi\'d2u k\'fa k\'d5 to\'b8n c\'e3 li\'aan quan \'ae\'d5n doanh thu v\'b5 thu nh\'cbp kh\'b8c \'ae\'ad\'eec x\'b8c \'ae\'denh m\'e9t c\'b8ch gi\'b8n ti\'d5p th\'d7 c\'b8c chi ph\'dd li
\'aan quan \'ae\'ad\'eec ghi nh\'cbn trong B\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh tr\'aan c\'ac s\'eb ph\'a9n b\'e6 theo h\'d6 th\'e8ng ho\'c6c theo t\'fb l\'d6. 
\par 
\par 47. M\'e9t kho\'b6n chi ph\'dd \'ae\'ad\'eec ghi nh\'cbn ngay v\'b5o B\'b8o c\'b8o k\'d5t qu\'b6 ho\'b9t \'ae\'e9ng kinh doanh trong k\'fa khi chi ph\'dd \'ae\'e3 kh\'abng \'aeem l\'b9i l\'eei \'ddch kinh t\'d5 trong c\'b8c k\'fa sau.
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\f15\fs26 
